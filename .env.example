# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false

# =============================================================================
# Security
# =============================================================================
# JWT secret key — must match LibreChat's JWT_SECRET
JWT_SECRET=your-jwt-secret-key

# =============================================================================
# Vector Database
# =============================================================================
# Options: pgvector | qdrant | milvus | chroma | weaviate | pinecone
VECTOR_DB_TYPE=pgvector

# PostgreSQL + pgvector
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@db:5432/mydatabase

# Qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Milvus
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# Chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_SSL=false

# Weaviate
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# Pinecone
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX=

# =============================================================================
# Embeddings
# =============================================================================
# Options: openai | azure | huggingface | ollama | cohere
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Azure OpenAI Embeddings
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002

# HuggingFace
# HF_TOKEN=
# HF_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# Cohere
# COHERE_API_KEY=
# COHERE_EMBEDDINGS_MODEL=embed-english-v3.0

# =============================================================================
# Document Processing
# =============================================================================
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
# Max file size in MB
PDF_MAX_FILE_SIZE=25
# Supported: pdf | docx | txt | md | csv | html | json
SUPPORTED_EXTENSIONS=pdf,docx,txt,md,csv,html,json

# =============================================================================
# RAG Retrieval
# =============================================================================
RAG_TOP_K=5
# Similarity threshold (0.0 ~ 1.0)
RAG_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# File Storage
# =============================================================================
# Options: local | s3 | azure_blob | gcs
FILE_STORAGE=local
LOCAL_STORAGE_PATH=uploads/

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER=

# GCS
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# =============================================================================
# Logging
# =============================================================================
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
